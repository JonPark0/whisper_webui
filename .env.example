# API Keys
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-flash-latest

# Whisper Configuration
# STT engine: "faster" (faster-whisper / CTranslate2, default) or
# "transformers" (original Hugging Face pipeline). Same model weights.
STT_ENGINE=faster
WHISPER_MODEL=openai/whisper-large-v3-turbo
FASTER_WHISPER_MODEL=deepdml/faster-whisper-large-v3-turbo-ct2
# Recognition language as ISO 639-1 (e.g. "ko"). Leave empty to auto-detect.
WHISPER_LANGUAGE=
# Segments decoded per batch by faster-whisper (measured on a 6 GB RTX 3060:
# batch 8 = 3.3 GB peak, batch 16 = 4.3 GB, same speed on 12-25 min files).
FASTER_BATCH_SIZE=8
ENABLE_FLASH_ATTENTION=false

# Server Configuration
BACKEND_PORT=8000
BACKEND_HOST=0.0.0.0
FRONTEND_PORT=5173
# Which host addresses the ports listen on. The frontend is open to the LAN
# (http://<server-LAN-IP>:5173); the backend only to this machine, since the
# UI reaches it through the frontend's /api proxy. 0.0.0.0 = every interface.
FRONTEND_BIND=0.0.0.0
BACKEND_BIND=127.0.0.1

# Images. docker compose runs the images published to GHCR by
# .github/workflows/image.yml; update with:
#   docker compose pull && docker compose up -d
# IMAGE_TAG: main = newest build of main; sha-<commit> = that commit's build
# (to roll back). Both images use the same tag.
IMAGE_TAG=main

# Development only: these apply when docker-compose.override.yml (copied from
# docker-compose.override.yml.example) builds the images from this checkout.
# Apply a change with `docker compose up -d --build`.
# FRONTEND_MODE: dev  = Vite dev server, edits under frontend/ show up live
#                prod = static build served by nginx, as in the published image
# RELOAD_MODE:   true = backend restarts itself on code changes (the override's
#                       default); false = no auto-reload (the published setup)
#FRONTEND_MODE=dev
#RELOAD_MODE=true

# Frontend API URL. Leave EMPTY (recommended): the browser calls /api on the
# same host it loaded the page from and the frontend container proxies it to
# the backend, so http://localhost:5173 and http://<server-LAN-IP>:5173 both
# work with no further settings (and no CORS). Set a full URL only if the API
# is served from a different origin than the UI.
VITE_API_URL=

# CORS Configuration (comma-separated list of allowed origins)
# For development: http://localhost:5173,http://localhost:3000
# For production: https://yourdomain.com
ALLOWED_ORIGINS=http://localhost:5173

# File Configuration
MAX_FILE_SIZE=500MB
UPLOAD_DIR=/app/uploads
OUTPUT_DIR=/app/outputs

# Processing Configuration
DEFAULT_TIMEOUT=3600

# Database Configuration
DB_PATH=/app/data/whisper.db

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json
