# API Keys
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-flash-latest

# Qwen3-ASR Configuration
QWEN_ASR_MODEL=Qwen/Qwen3-ASR-1.7B
QWEN_ALIGNER_MODEL=Qwen/Qwen3-ForcedAligner-0.6B
# Force recognition language using Qwen3-ASR canonical names (e.g. "Korean",
# "English"). Leave empty to auto-detect.
QWEN_LANGUAGE=
# Optional hotwords/domain vocabulary hint passed to the model as context.
QWEN_CONTEXT=
# Long audio is split at the quietest point near every N seconds and the
# pieces are decoded PIPELINE_BATCH_SIZE at a time. Lower it if long files
# hit CUDA OOM. Timestamped jobs are capped at 180s (forced-aligner limit).
QWEN_MAX_CHUNK_SEC=60
ENABLE_FLASH_ATTENTION=false
# Chunks processed simultaneously by the ASR model (max_inference_batch_size).
# Lower values reduce VRAM usage at the cost of speed.
PIPELINE_BATCH_SIZE=4

# Server Configuration
BACKEND_PORT=8000
BACKEND_HOST=0.0.0.0
FRONTEND_PORT=5173

# Development vs. production. Apply a change with:
#   docker compose up -d --build
# FRONTEND_MODE: dev  = Vite dev server, edits under frontend/ show up live
#                prod = static build served by nginx (smaller, faster, meant
#                       for sharing beyond your own machine); UI edits need a
#                       rebuild. Both serve on FRONTEND_PORT and proxy /api.
# RELOAD_MODE:   true = backend restarts itself on code changes (development)
#                false = no auto-reload; use with FRONTEND_MODE=prod
FRONTEND_MODE=dev
RELOAD_MODE=true

# Frontend API URL. Leave EMPTY (recommended): the browser calls /api on the
# same host it loaded the page from and the frontend container proxies it to
# the backend, so http://localhost:5173 and http://<server-LAN-IP>:5173 both
# work with no further settings (and no CORS). Set a full URL only if the API
# is served from a different origin than the UI.
VITE_API_URL=

# CORS Configuration (comma-separated list of allowed origins)
# For development: http://localhost:5173,http://localhost:3000
# For production: https://yourdomain.com
ALLOWED_ORIGINS=http://localhost:5173

# File Configuration
MAX_FILE_SIZE=500MB
UPLOAD_DIR=/app/uploads
OUTPUT_DIR=/app/outputs

# Processing Configuration
DEFAULT_TIMEOUT=3600

# Database Configuration
DB_PATH=/app/data/whisper.db

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json
