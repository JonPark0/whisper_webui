# API Keys
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-flash-latest

# Whisper Configuration
# STT engine: "faster" (faster-whisper / CTranslate2, default) or
# "transformers" (original Hugging Face pipeline). Same model weights.
STT_ENGINE=faster
WHISPER_MODEL=openai/whisper-large-v3-turbo
FASTER_WHISPER_MODEL=deepdml/faster-whisper-large-v3-turbo-ct2
# Recognition language as ISO 639-1 (e.g. "ko"). Leave empty to auto-detect.
WHISPER_LANGUAGE=
# Segments decoded per batch by faster-whisper (measured on a 6 GB RTX 3060:
# batch 8 = 3.3 GB peak, batch 16 = 4.3 GB, same speed on 12-25 min files).
FASTER_BATCH_SIZE=8
ENABLE_FLASH_ATTENTION=false

# Server Configuration
BACKEND_PORT=8000
BACKEND_HOST=0.0.0.0
FRONTEND_PORT=5173
RELOAD_MODE=true

# Frontend API URL. Leave EMPTY (recommended): the browser calls /api on the
# same host it loaded the page from and the frontend container proxies it to
# the backend, so http://localhost:5173 and http://<server-LAN-IP>:5173 both
# work with no further settings (and no CORS). Set a full URL only if the API
# is served from a different origin than the UI.
VITE_API_URL=

# CORS Configuration (comma-separated list of allowed origins)
# For development: http://localhost:5173,http://localhost:3000
# For production: https://yourdomain.com
ALLOWED_ORIGINS=http://localhost:5173

# File Configuration
MAX_FILE_SIZE=500MB
UPLOAD_DIR=/app/uploads
OUTPUT_DIR=/app/outputs

# Processing Configuration
DEFAULT_TIMEOUT=3600

# Database Configuration
DB_PATH=/app/data/whisper.db

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json
